# Leadership / local sample demo (recommended default)
NEXT_PUBLIC_LOCAL_DEMO=1
NEXT_PUBLIC_HIDE_STORE_LOGIN=1

# Legacy hosted Firebase demo only (not for leadership walkthrough)
# NEXT_PUBLIC_LOCAL_DEMO=0
# NEXT_PUBLIC_HIDE_STORE_LOGIN=0

# Server auth (set in deployment secret store; never commit values)
STORE_PASSWORDS=
MANAGER_PASSWORD=
DEMO_STORE_CODE=demo-hub
DEMO_STORE_PASSWORD=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MANAGER_PASSWORD_OVERRIDE=
MANAGER_PASSWORD_OVERRIDE_EMAIL=
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REFRESH_TOKEN=
TESLA_AUDIENCE=
