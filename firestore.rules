rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio / demo mode: any signed-in user (anonymous auth) can read and write.
    // Store access is enforced in the app via httpOnly session cookies, not Firestore claims.
    match /stores/{storeId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /stores/{storeId} {
      allow read, write: if request.auth != null;
    }
  }
}
